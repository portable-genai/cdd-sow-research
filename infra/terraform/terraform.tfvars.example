# terraform.tfvars.example — copy to terraform.tfvars and fill in.
#
# Pick ONE of the three scenarios below (they layer: B is the default posture, A relaxes
# it, C adds a second instance/enterprise on top of A or B).
# NEVER commit a real terraform.tfvars (it is gitignored).

# =========================================================================== #
# (A) QUICK EVALUATION DEPLOY: project-scoped, no org-level roles needed.     #
#     Fast first apply into a sandbox project; everything stays deletable.    #
#     NOT compliant for production (no perimeter, no org policies, no WORM    #
#     lock). Flip the three toggles back to their defaults before any         #
#     production use.                                                         #
# =========================================================================== #

# Target project (required in every scenario). Single-tenant, in-region.
project_id = "your-project"

# Skip the VPC-SC perimeter: needs an org-level Access Context Manager policy you may not
# have for an evaluation. Not compliant for production.
enable_vpc_sc = false

# Skip the project-level Org Policy guardrails: needs roles/orgpolicy.policyAdmin on the
# project. The per-resource region pins still apply. Not compliant for production.
enable_org_policies = false

# Do NOT lock the WORM audit bucket, so `terraform destroy` still works. Locking is
# IRREVERSIBLE, so evaluation stacks keep it false. Not compliant for production.
worm_locked = false

# =========================================================================== #
# (B) FULL SOVEREIGN DEPLOY: the default posture (all three toggles above     #
#     default to the compliant values; simply omit them).                     #
# =========================================================================== #

# Deploy region, SELECTED HERE. Defaults to asia-southeast1. Validated
# against allowed_regions: an unapproved region fails fast at `terraform plan` (P-03).
# region = "asia-southeast1"

# Residency allowlist. Extend ONLY after confirming the full stack (Document AI, DLP,
# Model Armor, Vertex, CMEK, Logging) + your obligations are met in that region.
# Default: SG, HK, Tokyo, Sydney, London.
# allowed_regions = ["asia-southeast1"]

# Access Context Manager policy id (numeric). REQUIRED when enable_vpc_sc = true (the
# default); plan fails fast without it. Create once per org with:
#   gcloud access-context-manager policies create --organization=ORG_ID --title="sg-residency"
# access_policy_id = "111111111111"

# Enforce the perimeter (true) vs dry-run/audit (false, default). Apply with false FIRST,
# watch the dry-run violation logs (monitoring.tf alerts on them), add operators below,
# then flip to true.
# vpc_sc_enforce = false

# Identities allowed to reach restricted APIs from outside the perimeter (an access level):
# operator_members = ["user:you@example.com", "serviceAccount:ci@your-project.iam.gserviceaccount.com"]

# Cloud Monitoring notification channel ids for the security alerts (guardrail blocks,
# SA-key creation, VPC-SC denials, CMEK changes). Empty = policies are created but notify
# nowhere; wire a channel in prod.
# alert_notification_channels = ["projects/your-project/notificationChannels/1234567890"]

# Domain-restricted sharing: only these customer/directory ids may receive IAM.
# Empty = that one policy is skipped. Applied only when enable_org_policies = true.
# allowed_policy_member_domains = ["C0xxxxxxx"]

# WORM audit retention in days (>= 180, six months). The lock (worm_locked = true, the
# default here in scenario B) is IRREVERSIBLE for this window: confirm before apply.
# retention_days = 180
# Existing locked stack only: declare its current value so Terraform rejects a reduction.
# New stack default is 0.
# existing_locked_retention_days = 2557

# App image for the scheduled sanctions-sync Cloud Run job. EMPTY (default) skips the job
# + scheduler (upload snapshots out-of-band via scripts/sync_sanctions.py --gcs); set it
# to enable the daily sync.
# sanctions_sync_image = "asia-southeast1-docker.pkg.dev/your-project/cdd/cdd-sow-research:v1"

# Optional named Modes 4/5 edge. Complete the deployment dossier before uncommenting.
# Both images must be immutable digest references. Secrets must already exist and contain
# the reviewed runtime settings and identical installation manifest bytes.
#
# deployment_stage                = "production-edge"
# production_edge_enabled          = true
# api_image                         = "asia-southeast1-docker.pkg.dev/your-project/doc1/doc1-api@sha256:REPLACE"
# ui_image                          = "asia-southeast1-docker.pkg.dev/your-project/doc1/doc1-ui@sha256:REPLACE"
# agent_domain                      = "doc1.bank.example"
# dns_managed_zone                  = "bank-example"
# installation_manifest_secret_id  = "doc1-installations"
# installation_manifest_secret_version = "7"
# runtime_settings_secret_id        = "doc1-production-settings"
# runtime_settings_secret_version   = "4"
# production_manifest_version       = "2026-07-27.1"
# production_manifest_sha256         = "REPLACE_WITH_64_LOWERCASE_HEX"
# production_settings_sha256         = "REPLACE_WITH_64_LOWERCASE_HEX"
# production_identity_mode          = "embedded-grant"
# enable_embed_signing_key           = true # Mode 5 only; irreversible key resource
# embed_signing_key_version          = "projects/PROJECT/locations/asia-southeast1/keyRings/cdd-sow-agent-ring/cryptoKeys/cdd-sow-agent-cmek-embed-signing/cryptoKeyVersions/1"
# edge_min_instances                = 2
# edge_max_instances                = 10
# additional_secret_env = {
#   CDD_EMBED_TOKEN_PUBLIC_KEY = {
#     secret_id = "doc1-embed-token-public-key"
#     version   = "3"
#   }
# }

# =========================================================================== #
# (C) SECOND INSTANCE / SECOND ENTERPRISE: repeatable rollout.                #
# =========================================================================== #

# Prefix for every resource name (default "cdd-sow" reproduces the historical names).
# Change it when: (a) a second instance must coexist in the SAME project, or (b) you
# destroyed a stack and are redeploying into the same project: the old KMS key ring is
# indestructible and a fresh prefix avoids colliding with it. 3-19 chars, lowercase;
# keep it <= 14 chars when enabling the sanctions job (SA id length limit, naming.tf).
# name_prefix = "cdd-sow-acme"

# Pair the region with a matching scheduler time zone per enterprise, e.g.:
#   London enterprise:    region = "europe-west2"    scheduler_time_zone = "Europe/London"
#   Sydney enterprise:    region = "australia-southeast1"  scheduler_time_zone = "Australia/Sydney"
#   Default:               region = "asia-southeast1" scheduler_time_zone = "UTC"
#   Singapore alternative: region = "asia-southeast1" scheduler_time_zone = "Asia/Singapore"
# region              = "europe-west2"
# scheduler_time_zone = "Europe/London"

# Scenario D — "inside the platform". A platform deployment where agent-guardrail-gateway (guardrail), agent-observability
# (WORM audit) and IAP/agent-registry (identity) front those concerns, so this repo does NOT
# provision its own Model Armor / DLP / WORM bucket+sink and does not serve /auth/*.
# IMMUTABLE per deployment: a compliant standalone deploy has a locked WORM bucket, which
# Terraform cannot destroy for the retention window, so flipping true->false is
# blocked in practice (destroy/recreate to change modes). Also set CDD_STANDALONE=false on
# the service.
# standalone = false
