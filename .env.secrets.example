# Doc1 secret values. Copy to `.env.secrets`, restrict access to the deployment
# operators, and never commit it. The preflight never prints these values.
#
# Dotenv values are literal. Unquoted values may not contain whitespace or `#`;
# backslashes and all other bytes are preserved. Single or double quotes remove only
# the matching outer pair and preserve every interior byte, including backslashes,
# whitespace, and `#`. Embedded copies of the chosen quote delimiter are rejected;
# use the other delimiter. There is no shell evaluation, interpolation, or inline comment.
# Printable credential bytes such as `$()`, backticks, and backslashes remain literal.

# Mode 6 OIDC and Doc1 session material. Preserve the provider-issued OIDC client
# secret exactly as supplied; it is opaque and is not generated or decoded here.
# The session key must be canonical padded base64 encoding exactly 32 generated
# high-diversity bytes (256 bits).
CDD_OIDC_CLIENT_SECRET=REPLACE_WITH_SECRET
CDD_SESSION_SIGNING_KEY=REPLACE_WITH_SECRET

# Base64-encoded reviewed payloads that will become immutable Secret Manager versions.
# Use canonical padded base64. The preflight decodes and schema-validates both payloads,
# then compares their exact bytes with the SHA-256 digests in the non-secret .env file.
# Resource ids and numeric versions remain in .env.
DOC1_INSTALLATION_MANIFEST_B64=REPLACE_WITH_BASE64_SECRET
DOC1_RUNTIME_SETTINGS_B64=REPLACE_WITH_BASE64_SECRET

# Optional direct Hrz7 integration secrets. Leave these lines COMMENTED OUT when the
# integration is not configured; do not ship them blank. hex-service-kit resolves an
# S2S credential in three states, so a present-but-empty value is an operator error and
# raises `ConfiguredEmptyError` instead of quietly sending an unauthenticated request.
# Absent means "no S2S credential", which is the offline zero-secret posture.
# CDD_S2S_TOKEN=REPLACE_WITH_SECRET
# CDD_S2S_SIGNING_KEY=REPLACE_WITH_SECRET
