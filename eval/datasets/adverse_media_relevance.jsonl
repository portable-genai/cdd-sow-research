{"id": "rel-same-jurisdiction-only", "subject": "Meridian Harbour Holdings Pte Ltd", "headline": "Singapore tightens beneficial ownership rules for holding companies", "snippet": "The change affects every holding company incorporated in the jurisdiction.", "keep": false}
