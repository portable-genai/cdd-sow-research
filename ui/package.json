    "build": "next build",
    "start": "next start",
    "lint": "tsc --noEmit",
    "pretest:unit": "npm run build:loader",
    "test:unit": "node --test tests/*.test.ts tests/*.test.mjs",
    "test:repo": "node --test tests/repo/*.test.ts",
