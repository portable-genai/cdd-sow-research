{
  "name": "b1-cdd-sow-research-ui",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "description": "Demo console for the B1 CDD + Source-of-Wealth Agent (doc group).",
  "scripts": {
    "build:loader": "node scripts/build-loader.mjs",
    "predev": "npm run build:loader",
    "dev": "next dev",
