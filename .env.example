# Doc1 CDD + Source-of-Wealth Agent: non-secret example environment.
#
# Copy to `.env` and fill in. NEVER commit a real `.env` (it is gitignored). Secret
# values belong only in `.env.secrets`, copied from `.env.secrets.example`.
# Values use the same literal parser documented there: backslashes are never escape
# characters, and ambiguous whitespace, quoting, or inline comments fail closed.
# The local/test profile needs none of the GCP-specific values, only CDD_PROFILE.

# ---------------------------------------------------------------------------
# Profile & project
# ---------------------------------------------------------------------------
# gcp | local | live | platform | onprem.  Default 'local' runs the whole pipeline OFFLINE
# (SQLite FTS5 + deterministic LLM), no Google Cloud SDK and no emulators required.
# 'live' reads REAL uploaded documents with a local model and researches the subject name
# with Gemini grounding; see the live section below.
CDD_PROFILE=local

# Independent identity and browser-channel selectors. Keep them explicit outside the
# compatibility local demo. Runtime never chooses identity, and identity never chooses
# compute/data adapters.
# local-persona | iap | oidc-session | oauth-access-token | embedded-grant | onprem
CDD_IDENTITY_PROFILE=local-persona
# native | sandboxed | standalone
CDD_CHANNEL_PROFILE=standalone

# One canonical external agent origin and fixed public mount. Required by oidc-session
# and sandboxed deployments; loopback HTTP is accepted only for local development.
CDD_PUBLIC_ORIGIN=http://127.0.0.1:8099
# Sandboxed channels additionally require a reviewed installation manifest.
# CDD_INSTALLATION_MANIFEST=/path/to/reviewed-installation-manifest.json
# CDD_INSTALLATION_MANIFEST_VERSION=1

# Who may frame the STANDALONE console, space or comma separated. Read identically by the
# FastAPI service and by the Next.js console, so the two cannot disagree. LEAVE IT UNSET
# for the shipped default of 'self' (framed by nothing but its own origin). Setting it to
# an empty value is REFUSED rather than treated as unset, and so is any wildcard: an empty
# frame-ancestors directive is a parse error browsers discard, which would remove the
# framing restriction altogether. Embed documents ignore this and use the parent origins
# their installation registered in the reviewed manifest above.
# CDD_FRAME_ANCESTORS=

# Local-persona is loopback-only unless this explicit insecure-demo acknowledgement is
# set. Hrz9's local launcher sets it only inside its loopback Doc1 backend process.
# CDD_ALLOW_INSECURE_DEMO=1

# Deprecated compatibility diagnostic only. It no longer selects channel or identity.
CDD_STANDALONE=true

# GCP project id (gcp/platform profiles only).
GOOGLE_CLOUD_PROJECT=your-gcp-project

# IAP identity verification (identity=iap).
# CDD_IAP_AUDIENCE=/projects/000000000000/global/backendServices/0000000000000000000

# Mode 6 OIDC session settings. Issuer/client metadata is configured in settings.yaml;
# these values provide the deployment's client credential and session signing key.
# CDD_OIDC_CLIENT_ID=replace-with-dedicated-google-oauth-client-id

# ---------------------------------------------------------------------------
# Live profile (CDD_PROFILE=live) — real documents, real subjects
# ---------------------------------------------------------------------------
# The local model server that reads the documents and writes the dossier. Give the FULL
# chat-completions endpoint: MLX serves /chat/completions, Ollama and vLLM serve
# /v1/chat/completions. Nothing here leaves the machine.
CDD_LIVE_LLM_URL=http://127.0.0.1:8001/chat/completions
CDD_LIVE_LLM_MODEL=mlx-community/gemma-4-26b-a4b-it-8bit
# Unset means reuse the model above (Gemma is multimodal).
# CDD_LIVE_VISION_MODEL=gemini-model-resource
# Seconds per model call.
CDD_LIVE_TIMEOUT=240
CDD_LIVE_MAX_TOKENS=2048
# Transcribe pages that have no text layer.
CDD_LIVE_OCR=true
# Per-document transcription budget.
CDD_LIVE_MAX_OCR_PAGES=10
CDD_LIVE_RENDER_DPI=150
# The cloud half: adverse media and corporate registry, which need a live web index. Needs
# ADC (`gcloud auth application-default login`) and GOOGLE_CLOUD_PROJECT above. Model ids
# are regional: pin one your region actually serves, or grounded research 404s and silently
# returns nothing.
# Unset means gemini-3.5-flash.
# CDD_REASONING_MODEL=gemini-3.5-flash
# Unset means gemini-3.1-flash-lite (not served in us-central1).
# CDD_TRIAGE_MODEL=gemini-3.1-flash-lite
# Per-document upload ceiling (bytes). The whole-request cap is CDD_MAX_BODY_BYTES.
CDD_MAX_UPLOAD_BYTES=26214400

# ---------------------------------------------------------------------------
# Local profile (CDD_PROFILE=local) — optional overrides
# ---------------------------------------------------------------------------
# SQLite stores. Unset => ~/.cdd_sow_research/{local.db,audit.db}; ":memory:" for ephemeral.
# CDD_LOCAL_DB=:memory:
# CDD_LOCAL_AUDIT=:memory:
# Custody of uploaded case documents (the bytes a citation links back to).
# Unset => ~/.cdd_sow_research/documents.db.
# CDD_LOCAL_DOCUMENTS=:memory:
# CDD_BROWSER_FLOW_DB=:memory:
# CDD_CLIENT_ASSERTION_REPLAY_DB=:memory:
CDD_PRODUCTION=false
CDD_REPLICA_COUNT=1
# Watchlist snapshot. Unset => the synced ~/.cdd_sow_research/sanctions_snapshot.json when it
# exists, else the BUNDLED FICTIONAL fixture, which no real name can ever match. Refresh:
#   PYTHONPATH=src python scripts/sync_sanctions.py --out ~/.cdd_sow_research/sanctions_snapshot.json
# CDD_LOCAL_SANCTIONS=/path/to/fictional-sanctions-snapshot.json
# Journey-demo only: Doc1's own durable SQLite delivery outbox. Unset defaults to
# ~/.cdd_sow_research/review-outbox.db. Use a journey-specific file when running the launcher.
# CDD_LOCAL_REVIEW_OUTBOX=/path/to/review-outbox.db
# Direct trusted-producer handoff to Hrz7. HTTP is accepted only for loopback local demos;
# deployments require HTTPS. The shared secret is synthetic for local runs and never committed.
# CDD_HRZ7_URL=http://127.0.0.1:8087
# CDD_S2S_TOKEN and CDD_S2S_SIGNING_KEY belong in .env.secrets.
# Optional higher-fidelity local runs: set these to route the in-process stores to
# Google's official emulators (the google client is imported lazily, only then). Leave
# UNSET for the default SDK-free, emulator-free local run.
# FIRESTORE_EMULATOR_HOST=localhost:8080
# PUBSUB_EMULATOR_HOST=localhost:8085
# STORAGE_EMULATOR_HOST=localhost:9023

# ---------------------------------------------------------------------------
# GCP region is selected once and shared by runtime and Terraform (default asia-southeast1).
# Do not add a region override here; residency depends on the pin.
# ---------------------------------------------------------------------------

# ---------------------------------------------------------------------------
# Security / residency (gcp profile)
# ---------------------------------------------------------------------------
# Regional Cloud KMS key for CMEK (projects/.../locations/asia-southeast1/.../cryptoKeys/...)
# CDD_KMS_KEY=projects/your-project/locations/asia-southeast1/keyRings/doc1/cryptoKeys/doc1

# Toggle public-web adverse-media grounding (the google_search sub-agent). true | false.
CDD_GROUNDING_ENABLED=true

# ---------------------------------------------------------------------------
# Document extraction — Document AI (gcp profile)
# ---------------------------------------------------------------------------
# Processor id: projects/.../locations/asia-southeast1/processors/...
# CDD_DOCAI_PROCESSOR=projects/your-project/locations/us/processors/replace-me

# ---------------------------------------------------------------------------
# PII redaction — Sensitive Data Protection / DLP (gcp profile)
# ---------------------------------------------------------------------------
# CDD_DLP_INSPECT_TEMPLATE=projects/your-project/locations/us/inspectTemplates/replace-me
# CDD_DLP_DEIDENTIFY_TEMPLATE=projects/your-project/locations/us/deidentifyTemplates/replace-me

# ---------------------------------------------------------------------------
# Agent Runtime (set AFTER you deploy the reasoningEngine)
# ---------------------------------------------------------------------------
# CDD_AGENT_ENGINE=projects/your-project/locations/asia-southeast1/reasoningEngines/replace-me

# ---------------------------------------------------------------------------
# Platform-profile sibling service URLs (consumed by the platform adapters).
# Defaults point at localhost; override per deployment.
# ---------------------------------------------------------------------------
# Hrz1 guardrail + redaction
GUARDRAIL_GATEWAY_URL=http://localhost:8080
# Hrz2 enterprise knowledge base (Doc1's RAG store)
KNOWLEDGE_BASE_URL=http://localhost:8082
# Hrz3 agent registry
AGENT_REGISTRY_URL=http://localhost:8083
# Hrz4 AI quality / eval gate
QUALITY_GATE_URL=http://localhost:8084
# Hrz5 observability / audit
OBSERVABILITY_URL=http://localhost:8085
# Rsk1 compliance assistant
RSK_COMPLIANCE_URL=http://localhost:8080

# Per-capability production evidence. Each reference must resolve to the distinct
# installation attestation for that capability; one global boolean cannot attest all.
# CDD_WORKFLOW_ATTESTATION_REF=replace-with-reviewed-reference
# CDD_EVALUATION_ATTESTATION_REF=replace-with-reviewed-reference
# CDD_AUDIT_ATTESTATION_REF=replace-with-reviewed-reference
# CDD_TRACE_ATTESTATION_REF=replace-with-reviewed-reference
# CDD_MODEL_ARMOR_ATTESTATION_REF=replace-with-reviewed-reference
# CDD_UI_ATTESTATION_REF=replace-with-reviewed-reference

# ---------------------------------------------------------------------------
# Optional: point at a non-default settings file.
# ---------------------------------------------------------------------------
# CDD_SETTINGS=config/settings.yaml

# ---------------------------------------------------------------------------
# Named-production deployment contract
# ---------------------------------------------------------------------------
# Keep false while values are placeholders. The preflight and Terraform runner fail closed
# on every placeholder once this is true. `make deploy-env-check` validates the draft;
# `make deploy-preflight` requires complete, approved inputs without contacting GCP.
DOC1_DEPLOYMENT_ENABLED=false
DOC1_NAME_PREFIX=cdd-sow
# new | existing. Plan/apply verifies live bucket absence or current locked retention.
DOC1_STACK_LIFECYCLE=new
# mode5-key-bootstrap creates only the approved HSM signing key; production-edge
# deploys the complete edge after the exact key version is recorded in runtime settings.
DOC1_DEPLOYMENT_STAGE=production-edge
# production | reference. ORTHOGONAL to the stage above: the stage says which part of the
# stack is applied, the posture says what the deployment is FOR.
#   production (default) — the full posture. Nothing is relaxed.
#   reference            — the maintainer-owned demonstration stack. Relaxes exactly two
#                          rules: the irreversible WORM lock is not demanded (so the stack
#                          stays destroyable) and fewer than two replicas is allowed (so an
#                          idle demo scales to zero). BOTH are printed by the preflight as
#                          explicit disclosures, because a relaxed rule that passes silently
#                          is how an evidence pack ends up claiming a control it never
#                          exercised. Everything else — residency, digest binding, exact
#                          origins, real alert channels, secret-version pinning — is
#                          unchanged, because those are what the deployment demonstrates.
DOC1_DEPLOYMENT_POSTURE=production

# Institution, ownership and evidence
DOC1_INSTITUTION=PLACEHOLDER_INSTITUTION
DOC1_INSTALLATION_NAME=PLACEHOLDER_INSTALLATION
# The one deployment tenant, whatever the identity mode. The manifest and the Mode 5
# subject policy both bind to this value; DOC1_MODE4_TENANT below must equal it when the
# deployment actually serves Mode 4.
DOC1_DEPLOYMENT_TENANT=PLACEHOLDER_TENANT
DOC1_DEPLOYMENT_OWNER=PLACEHOLDER_DEPLOYMENT_OWNER
DOC1_SECURITY_OWNER=PLACEHOLDER_SECURITY_OWNER
DOC1_OPERATIONS_OWNER=PLACEHOLDER_OPERATIONS_OWNER
DOC1_EVIDENCE_APPROVER=PLACEHOLDER_EVIDENCE_APPROVER
DOC1_INCIDENT_CHANNEL=PLACEHOLDER_INCIDENT_CHANNEL
DOC1_EVIDENCE_LOCATION=PLACEHOLDER_EVIDENCE_LOCATION

# Cloud, residency and irreversible controls. Set GOOGLE_CLOUD_PROJECT in the profile section
# above. Six months is the default minimum.
GCP_REGION=asia-southeast1
DOC1_ALLOWED_REGIONS=asia-southeast1
# Optional Hrz5 collector. The adapter adds /v1/traces automatically. A *.run.app
# endpoint receives a Google-signed ID token; override the token audience only when
# an authenticated proxy exposes a different public URL.
# OTEL_EXPORTER_OTLP_ENDPOINT=https://collector.example.test
# OTEL_EXPORTER_OTLP_AUDIENCE=https://collector.example.test
OTEL_EXPORTER_OTLP_CLOUD_RUN_AUTH=false
DOC1_ACCESS_POLICY_ID=PLACEHOLDER_ACCESS_POLICY_ID
DOC1_TERRAFORM_STATE_BUCKET=PLACEHOLDER_TERRAFORM_STATE_BUCKET
DOC1_TERRAFORM_STATE_PREFIX=PLACEHOLDER_STATE_PREFIX
DOC1_AUDIT_RETENTION_DAYS=180
# Set 0 for a new stack. Existing locked stacks must declare their current value, such as 2557.
DOC1_EXISTING_LOCKED_RETENTION_DAYS=0
DOC1_WORM_LOCK_APPROVED=false
DOC1_EDGE_MIN_INSTANCES=2
DOC1_ALERT_NOTIFICATION_CHANNELS=PLACEHOLDER_NOTIFICATION_CHANNELS
# Use dry-run for the first deployment. Change both fields only after recording clean
# dry-run evidence; the preflight checks their relationship.
DOC1_DEPLOYMENT_PHASE=dry-run
DOC1_VPC_SC_ENFORCE=false
DOC1_VPC_SC_DRY_RUN_EVIDENCE=PLACEHOLDER_POST_DRY_RUN_EVIDENCE

# DNS, certificates, images and reviewed Secret Manager versions
DOC1_AGENT_DOMAIN=doc1.example.com
DOC1_STANDALONE_DOMAIN=doc1-login.example.com
DOC1_DNS_MANAGED_ZONE=PLACEHOLDER_DNS_MANAGED_ZONE
DOC1_DNS_OWNER=PLACEHOLDER_DNS_OWNER
DOC1_CERTIFICATE_OWNER=PLACEHOLDER_CERTIFICATE_OWNER
DOC1_API_IMAGE=asia-southeast1-docker.pkg.dev/your-gcp-project/doc1/api@sha256:REPLACE
DOC1_UI_IMAGE=asia-southeast1-docker.pkg.dev/your-gcp-project/doc1/ui@sha256:REPLACE
DOC1_INSTALLATION_MANIFEST_SECRET_ID=PLACEHOLDER_MANIFEST_SECRET_ID
DOC1_INSTALLATION_MANIFEST_SECRET_VERSION=PLACEHOLDER_NUMERIC_VERSION
DOC1_INSTALLATION_MANIFEST_SHA256=PLACEHOLDER_SHA256
DOC1_RUNTIME_SETTINGS_SECRET_ID=PLACEHOLDER_SETTINGS_SECRET_ID
DOC1_RUNTIME_SETTINGS_SECRET_VERSION=PLACEHOLDER_NUMERIC_VERSION
DOC1_RUNTIME_SETTINGS_SHA256=PLACEHOLDER_SHA256
DOC1_PRODUCTION_MANIFEST_VERSION=PLACEHOLDER_IMMUTABLE_VERSION

# Browser installation
DOC1_INSTALLATION_IDS=PLACEHOLDER_INSTALLATION_ID
DOC1_APPROVED_PARENT_ORIGINS=https://portal.example.com

# Named edge selects Mode 4 or Mode 5. The Mode 5 and Mode 6 registrations are always
# required, because Mode 6 is the separate recovery/fallback path. The Mode 4 block below
# is required ONLY when this is oauth-access-token: an embedded-grant deployment records
# Mode 4 as not applicable and may leave every DOC1_MODE4_* value blank.
DOC1_PRODUCTION_IDENTITY_MODE=oauth-access-token
DOC1_EMBED_SIGNING_PROTECTION_LEVEL=HSM
# Mode 5 production-edge only. Copy the exact bootstrap
# `terraform output -raw embed_signing_key_version` value.
# DOC1_EMBED_SIGNING_KEY_VERSION=projects/your-project/locations/asia-southeast1/keyRings/doc1/cryptoKeys/doc1-embed-signing/cryptoKeyVersions/1

# Mode 4: institution access token. Required only when
# DOC1_PRODUCTION_IDENTITY_MODE=oauth-access-token; leave blank otherwise.
DOC1_MODE4_ISSUER=https://idp.example.com
DOC1_MODE4_JWKS_URI=https://idp.example.com/.well-known/jwks.json
DOC1_MODE4_RESOURCE_AUDIENCE=https://doc1.example.com/agent/api
DOC1_MODE4_TENANT=PLACEHOLDER_TENANT
DOC1_MODE4_ALLOWED_CLIENTS=PLACEHOLDER_CLIENT_IDS
DOC1_MODE4_REQUIRED_SCOPES=cdd.read,cdd.write
DOC1_MODE4_CLAIM_MAPPING_OWNER=PLACEHOLDER_CLAIM_MAPPING_OWNER
DOC1_MODE4_NEGATIVE_TEST_OWNER=PLACEHOLDER_NEGATIVE_TEST_OWNER

# Mode 5: brokered BFF grant. The subject token type is reviewed configuration; with
# urn:ietf:params:oauth:token-type:id_token the subject audience is the dedicated OAuth
# client id rather than a broker URL, and the subject client is its authorised party.
DOC1_MODE5_SUBJECT_TOKEN_TYPE=urn:ietf:params:oauth:token-type:access_token
DOC1_MODE5_SUBJECT_ISSUER=https://idp.example.com
DOC1_MODE5_SUBJECT_JWKS_URI=https://idp.example.com/.well-known/jwks.json
DOC1_MODE5_SUBJECT_AUDIENCE=https://doc1-broker.example.com
DOC1_MODE5_SUBJECT_CLIENT=PLACEHOLDER_SUBJECT_CLIENT
DOC1_MODE5_GRANT_SCOPE=cdd.embed
DOC1_MODE5_RESOURCE_AUDIENCE=https://doc1.example.com/agent/api
DOC1_MODE5_RESOURCE_SCOPES=cdd.read,cdd.write
DOC1_MODE5_BFF_CLIENT_ID=PLACEHOLDER_BFF_CLIENT
DOC1_MODE5_BFF_AUTH_METHOD=private_key_jwt
DOC1_MODE5_BFF_JWKS_URI=https://portal.example.com/.well-known/doc1-bff-jwks.json
DOC1_MODE5_REVOCATION_OWNER=PLACEHOLDER_REVOCATION_OWNER

# Mode 6: separate top-level OIDC fallback
DOC1_MODE6_ISSUER=https://idp.example.com
DOC1_MODE6_CLIENT_ID=PLACEHOLDER_MODE6_CLIENT
DOC1_MODE6_CALLBACK_URL=https://doc1-login.example.com/auth/callback
DOC1_MODE6_SUBJECT_LINKS_OWNER=PLACEHOLDER_SUBJECT_LINKS_OWNER
