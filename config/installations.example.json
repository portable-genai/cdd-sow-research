{
  "schema_version": 1,
  "deployment_manifest_id": "doc1-demo-bank-embed",
  "build_id": "doc1-ui-api-build",
  "installations": {
    "inst_demo_bank": {
      "tenant": "demo-bank",
      "parent_origins": [
        "https://portal.demo-bank.example"
      ],
      "resource_audience": "https://doc1.example/api",
      "scopes": [
        "cdd.read",
        "cdd.write",
        "documents.read",
        "documents.write"
      ],
      "identity_mode": "embedded-grant",
      "issuer_policy_id": "demo-bank-launch",
      "allowed_clients": [
        "demo-bank-portal-bff"
      ],
      "protocol_versions": [
        "1"
      ],
      "public_origin": "https://doc1.bank-agent.example",
      "public_mount_path": "/agent",
      "loader_version": "v1",
      "fallback_url": "https://doc1-standalone.example/agent/",
      "presentation_defaults": {
        "theme": "system",
        "density": "comfortable"
      }
    }
  }
}
